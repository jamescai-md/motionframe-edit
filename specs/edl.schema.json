{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<you>/motionframe-edit/specs/edl.schema.json",
  "title": "motionframe-edit EDL",
  "description": "The edit decision list: the single source of truth for a cut. Everything downstream (captions, overlays, sound, notes, gates) is derived from it and expressed in OUTPUT time.",
  "type": "object",
  "required": ["version", "profile", "sources", "segments"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "description": "Short slug used in filenames." },
    "profile": {
      "oneOf": [
        { "enum": ["vertical-9x16", "square-1x1", "landscape-16x9", "master-16x9"] },
        {
          "type": "object",
          "required": ["width", "height", "fps"],
          "properties": {
            "name": { "type": "string" },
            "width": { "type": "integer", "minimum": 16, "multipleOf": 2 },
            "height": { "type": "integer", "minimum": 16, "multipleOf": 2 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "fit": { "enum": ["fill", "pad"] },
            "loudness_lufs": { "type": "number" },
            "true_peak_db": { "type": "number" },
            "max_dead_stretch_s": { "type": "number" },
            "safe": {
              "type": "object",
              "properties": {
                "top": { "type": "number", "minimum": 0, "maximum": 1 },
                "bottom": { "type": "number", "minimum": 0, "maximum": 1 },
                "left": { "type": "number", "minimum": 0, "maximum": 1 },
                "right": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "object",
      "description": "Media id → path, relative to the EDL.",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "description": "A key of `sources`." },
          "start": { "type": "number", "minimum": 0, "description": "Source seconds." },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "speed": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
          "beat": { "type": "string", "description": "HOOK / PROBLEM / PROOF / TURN / CTA …" },
          "quote": { "type": "string", "description": "What is said, for review." },
          "reason": { "type": "string", "description": "Why this take of this beat." },
          "fit": { "enum": ["fill", "pad"] },
          "framing": {
            "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 2, "maxItems": 2,
            "description": "Crop bias [x,y]; 0.5,0.5 is centre, 0.5,0.38 lifts the subject."
          },
          "grade": { "type": "string" },
          "fade_in": { "type": "number", "minimum": 0, "maximum": 0.25, "default": 0.03 },
          "fade_out": { "type": "number", "minimum": 0, "maximum": 0.25, "default": 0.03 },
          "word_edges": {
            "type": "array",
            "description": "Optional guard: cut edges must not fall inside these words.",
            "items": {
              "type": "object",
              "properties": {
                "w": { "type": "string" },
                "start": { "type": "number" },
                "end": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "at", "dur"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "src": { "type": "string" },
          "at": { "type": "number", "minimum": 0, "description": "OUTPUT seconds." },
          "dur": { "type": "number", "exclusiveMinimum": 0 },
          "x": { "type": ["integer", "string"], "default": 0 },
          "y": { "type": ["integer", "string"], "default": 0 },
          "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "style": { "enum": ["bold-pop", "clean-line", "quiet-box"] },
        "file": { "type": "string", "description": "Generated ASS, relative to the EDL." }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loudness_lufs": { "type": "number" },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string" },
            "gain_db": { "type": "number", "default": -19 },
            "duck_db": { "type": "number", "default": -6 }
          }
        }
      }
    }
  }
}
